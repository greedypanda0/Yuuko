{
  "name": "yuuko",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier --check .",
    "check": "yarn typecheck && yarn format:check",
    "pretty": "yarn format"
  },
  "type": "module",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "colors": "^1.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.8.1",
    "prettier": "3.9.7",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
